const QuizEngine = (()=>{
    const PUNTOS_TOTALES = 5;
    let preguntas = [];
    let indiceActual = 0;
    let puntuacion = 0;
    let puntosPorPregunta = 1;
    let usuarioDocumento = null;
    let jsonCargado = false;
    function shuffleArray(array) {
        const shuffled = [
            ...array
        ];
        for(let i = shuffled.length - 1; i > 0; i--){
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [
                shuffled[j],
                shuffled[i]
            ];
        }
        return shuffled;
    }
    const backupQuestions = [
        {
            id: 1,
            tema: "P\xe9ndulos",
            pregunta: "\xbfCu\xe1l es la f\xf3rmula del per\xedodo de un p\xe9ndulo simple?",
            opciones: [
                "T = 2\u03C0\u221A(m/k)",
                "T = 2\u03C0\u221A(L/g)",
                "T = 2\u03C0\u221A(g/L)",
                "T = 2\u03C0\u221A(k/m)"
            ],
            respuesta: 1,
            hints: {
                correcto: "L es longitud, g es gravedad",
                incorrecto: "La f\xf3rmula con m y k es para masa-resorte"
            }
        },
        {
            id: 2,
            tema: "Resortes",
            pregunta: "\xbfQu\xe9 establece la Ley de Hooke?",
            opciones: [
                "F = ma",
                "F = -kx",
                "F = mv\xb2/r",
                "F = Gm\u2081m\u2082/r\xb2"
            ],
            respuesta: 1,
            hints: {
                correcto: "F = -kx indica que la fuerza es proporcional a la deformaci\xf3n",
                incorrecto: "F = ma es la Segunda Ley de Newton"
            }
        },
        {
            id: 3,
            tema: "Ondas",
            pregunta: "\xbfQu\xe9 relaci\xf3n existe entre frecuencia y per\xedodo?",
            opciones: [
                "f = T",
                "f = 1/T",
                "f = T\xb2",
                "f = \u221AT"
            ],
            respuesta: 1,
            hints: {
                correcto: "La frecuencia es el inverso del per\xedodo",
                incorrecto: "No son iguales, est\xe1n inversamente relacionados"
            }
        },
        {
            id: 4,
            tema: "Mecanica",
            pregunta: "\xbfQu\xe9 representa la amplitud de una onda?",
            opciones: [
                "N\xfamero de oscilaciones por segundo",
                "Distancia entre crestas",
                "Desplazamiento m\xe1ximo del equilibrio",
                "Velocidad de propagaci\xf3n"
            ],
            respuesta: 2,
            hints: {
                correcto: "Es el desplazamiento m\xe1ximo desde el punto de equilibrio",
                incorrecto: "Esa es la longitud de onda, no la amplitud"
            }
        },
        {
            id: 5,
            tema: "Electromagnetica",
            pregunta: "\xbfA qu\xe9 velocidad se propagan las ondas electromagn\xe9ticas en el vac\xedo?",
            opciones: [
                "3\xd710\u2076 m/s",
                "3\xd710\u2078 m/s",
                "3\xd710\xb9\u2070 m/s",
                "3\xd710\u2074 m/s"
            ],
            respuesta: 1,
            hints: {
                correcto: "c \u2248 3\xd710\u2078 m/s es la velocidad de la luz",
                incorrecto: "Esa velocidad es mucho menor al de la luz"
            }
        }
    ];
    async function cargarPreguntas() {
        try {
            const response = await fetch(window.location.origin + '/data/preguntas.json');
            if (!response.ok) throw new Error('Network response was not ok');
            const data = await response.json();
            jsonCargado = true;
            preguntas = shuffleArray(data).slice(0, 10);
            puntosPorPregunta = PUNTOS_TOTALES / preguntas.length;
            console.log("\u2705 preguntas.json cargado:", preguntas.length, 'preguntas');
        } catch (err) {
            jsonCargado = false;
            preguntas = shuffleArray(backupQuestions).slice(0, 10);
            puntosPorPregunta = PUNTOS_TOTALES / preguntas.length;
            console.warn("\u26A0\uFE0F Error cargando preguntas.json, usando respaldo:", err.message);
        }
    }
    function getQuestions() {
        return preguntas;
    }
    function getIndiceActual() {
        return indiceActual;
    }
    function getPuntuacion() {
        return puntuacion;
    }
    function getPuntosPorPregunta() {
        return puntosPorPregunta;
    }
    function getPuntosTotales() {
        return PUNTOS_TOTALES;
    }
    function getUsuarioDocumento() {
        return usuarioDocumento;
    }
    function esJsonCargado() {
        return jsonCargado;
    }
    function iniciarQuiz(documento) {
        usuarioDocumento = documento;
        indiceActual = 0;
        puntuacion = 0;
    }
    function verificarRespuesta(esCorrecta) {
        if (esCorrecta) {
            puntuacion += puntosPorPregunta;
            if (puntuacion > PUNTOS_TOTALES) puntuacion = PUNTOS_TOTALES;
        }
        return esCorrecta;
    }
    function avanzarPregunta() {
        if (indiceActual < preguntas.length - 1) {
            indiceActual++;
            return false;
        }
        return true;
    }
    function reiniciar() {
        usuarioDocumento = null;
        indiceActual = 0;
        puntuacion = 0;
    }
    return {
        cargarPreguntas,
        getQuestions,
        getIndiceActual,
        getPuntuacion,
        getPuntosPorPregunta,
        getPuntosTotales,
        getUsuarioDocumento,
        esJsonCargado,
        iniciarQuiz,
        verificarRespuesta,
        avanzarPregunta,
        reiniciar
    };
})();

